# Phase 8.6-1 single-host deployment template.
# Copy to `.env` (gitignored, never committed) and fill in secrets.
# `.env` is loaded by Compose via `env_file`, NOT by the application itself.

# Host-side API port, published on loopback only (see compose.yaml).
HOST_PORT=8000

# In-container paths. Keep these unless you changed the volume layout.
AIWF_DATABASE=/app/data/aiwf.sqlite3
AIWF_PROFILES_FILE=/app/config/profiles.json

# --- Secrets below. Empty here; set real values only in `.env`. ---
# Referenced from the database as env:NAME (credential references only).

# AI provider key used by the seeded OPENAI connection (env:OPENAI_API_KEY).
OPENAI_API_KEY=

# Groq key, only if a workspace connection references env:GROQ_API_KEY.
GROQ_API_KEY=

# WordPress application password for publishing targets that reference it.
AIWF_WP_APP_PASSWORD=
